# 默认演示入口只运行 ScriptedModel；smoke 从 --env-file 读取地址。
# 填写自己的服务地址。没有源码地址或进程环境回退。
AGENT_BASE_URL=
# Pilot 使用已有用户模型配置；不从 smoke 常量或进程环境猜测模型。
AGENT_MODEL=
# 可选角色覆盖；不设置时继承 AGENT_MODEL/AGENT_BASE_URL。
# RETAIL_USER_MODEL=
# RETAIL_USER_BASE_URL=
# RETAIL_COMMUNICATE_MODEL=
# RETAIL_COMMUNICATE_BASE_URL=
# RETAIL_NL_MODEL=
# RETAIL_NL_BASE_URL=
# 只在正式 smoke --execute 时加载认证；--check-config/冻结计划不加载认证。
DASHSCOPE_API_KEY=
